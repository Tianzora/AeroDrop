{
  "name": "aerodrop",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.8.2",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --config wrangler.jsonc",
    "preview:e2e": "vite build --mode e2e && vite preview --host 127.0.0.1 --port 3401 --strictPort",
    "test:receive": "node ./scripts/run-node-tests.mjs services/receive",
    "test:send": "node ./scripts/run-node-tests.mjs services/send",
    "test:services": "node ./scripts/run-node-tests.mjs services",
    "test:components": "node ./scripts/run-node-tests.mjs components",
    "test:scripts": "node ./scripts/run-node-tests.mjs scripts",
    "test:all": "npm run test:services && npm run test:components && npm run test:scripts",
    "test:e2e": "start-server-and-test preview:e2e http://127.0.0.1:3401 test:e2e:raw",
    "test:e2e:raw": "playwright test --project=chromium",
    "test:e2e:rtc": "start-server-and-test preview:e2e http://127.0.0.1:3401 test:e2e:rtc:raw",
    "test:e2e:rtc:raw": "playwright test --config=playwright.rtc.config.ts",
    "test:e2e:product-transfer": "start-server-and-test preview http://127.0.0.1:8787 test:e2e:product-transfer:raw",
    "test:e2e:product-transfer:raw": "playwright test --config=playwright.product.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:worker": "npm run deploy"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@zip.js/zip.js": "^2.8.26",
    "lucide-react": "^0.555.0",
    "motion": "^14.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "streamsaver": "^2.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/streamsaver": "^2.0.5",
    "@vitejs/plugin-react": "^6.2.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^8.3.6",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "ws": "^8.22.1"
  }
}
